# Database
DATABASE_URL=postgresql://user:password@localhost:5432/trading_bot
INITIAL_CAPITAL=5000
MAX_POSITIONS=5
RISK_PER_TRADE=0.02

# Trading Configuration
MIN_CONFIDENCE_SCORE=60
ADAPTIVE_SCORING=true
WATCHLIST_TYPE=custom

# Reporting# Scan Data Reporting
SAVE_SCAN_DATA=true
MIN_SCORE_TO_SAVE=60              # Only save stocks scoring >= 60 (reduces DB usage by ~85%)
SCAN_DATA_RETENTION_DAYS=90

# Notifications
NOTIFICATION_EMAIL=your_email@example.com
RESEND_API_KEY=re_your_api_key_here

# API Security (Optional but recommended)
# Unlocks manual trigger endpoints
API_WEBHOOK_KEY=your_super_secret_key_here

# Environment
FLASK_ENV=development
DEBUG=True
